{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["approve", "request_changes"],
      "description": "approve only when there is no blocking problem in the diff"
    },
    "summary": {
      "type": "string",
      "description": "Two or three sentences describing what the change does and whether it is sound."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "detail"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["blocking", "should-fix", "nit"]
          },
          "detail": {
            "type": "string",
            "description": "One sentence naming the file and the problem."
          }
        }
      }
    }
  }
}
